{
  "name": "claude-sessions",
  "version": "0.6.5",
  "private": true,
  "description": "Claude-Code-Sessions verwalten",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.github.cmimar01.claude-sessions",
    "productName": "Claude Sessions",
    "artifactName": "claude-sessions-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "cmimar01",
      "repo": "claude-sessions"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
